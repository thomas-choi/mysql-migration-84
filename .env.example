# Copy to .env and fill in: cp .env.example .env
# Quote values that contain spaces or shell metacharacters: SRC_PASSWORD='p@ss$word'

# Source: MySQL 8.0 server (export_mysql80.sh)
# Needs SELECT, SHOW VIEW, TRIGGER, EVENT, LOCK TABLES on the exported schemas,
# plus SELECT on mysql.* for --with-users.
SRC_HOST=127.0.0.1
SRC_PORT=3306
SRC_USER=root
SRC_PASSWORD=changeme

# Target: MySQL 8.4 server (import_mysql84.sh)
# An admin account is simplest (it creates databases, users, and DEFINER objects).
DST_HOST=127.0.0.1
DST_PORT=3306
DST_USER=root
DST_PASSWORD=changeme

# Where exports go; each run makes a timestamped subdirectory.
EXPORT_DIR=./exports

# Client tools. Uses a local MySQL 8.4 mysqldump if one is on PATH, else this
# Docker image. Set MYSQL_BIN_DIR to force a specific local 8.4 client install.
MYSQL84_IMAGE=mysql:8.4
# MYSQL_BIN_DIR=/opt/mysql-8.4/bin
# Docker network for the client container. "host" reaches servers on this
# machine's 127.0.0.1 (native Docker on Linux/WSL2). With Docker Desktop, use
# SRC_HOST/DST_HOST=host.docker.internal and DOCKER_NETWORK=bridge.
DOCKER_NETWORK=host
